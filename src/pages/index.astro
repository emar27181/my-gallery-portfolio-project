---
import Gallery from "../components/organisms/Gallery.astro";
import LoadingScreen from "../components/organisms/LoadingScreen.astro";
import NavBar from "../components/organisms/NavBar.astro";
import { getBrandImages } from "../lib/brand-images";
import { THEME_STORAGE_KEY } from "../lib/theme";
import "../styles/global.css";

const { tabIcon } = await getBrandImages();
const MAIN_ID = "main-content";
---

<html lang="ja" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={tabIcon} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="uyjBT9z6vOnpxn6lM6YnxbI6R4jLSDIAboC8zo1slhM" />
    <title>emar27181 Gallery</title>
    <!-- 描画前に保存済みテーマを当て、ライト→ダークのちらつきを防ぐ -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      try {
        if (localStorage.getItem(key) === "dark") document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>
  </head>
  <body>
    <div id="top"></div>
    <NavBar />
    <LoadingScreen target={MAIN_ID} />
    <main id={MAIN_ID} data-loading-hidden>
      <Gallery />
    </main>
  </body>
</html>
