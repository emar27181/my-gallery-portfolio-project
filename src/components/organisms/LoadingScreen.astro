---
// ローディング画面（organism）: サインのアニメーションを見せ、ギャラリーの初期表示の準備
// （gallery:ready）を待って閉じる。閉じたら data-loading-target の要素を見せる。
import { getBrandImages } from "../../lib/brand-images";

interface Props {
  /** 閉じた後に見せる要素の id */
  target: string;
}

const { target } = Astro.props;
const { loading } = await getBrandImages();
---

<div id="loading-screen" class="loading" data-loading-target={target} data-animation-duration={loading.durationMs} data-final-frame={loading.finalFrame}>
  <img
    class="loading__animation"
    src={loading.src}
    width={loading.width}
    height={loading.height}
    alt="Loading..."
    fetchpriority="high"
  />
</div>

<style>
  .loading {
    position: fixed;
    top: var(--layout-navbar-height);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-loading);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
    transition: opacity var(--duration-slow) var(--easing-standard);
  }
  .loading.is-leaving {
    opacity: 0;
  }
  .loading__animation {
    width: auto;
    height: auto;
    max-width: 40vw;
    max-height: 40vh;
    object-fit: contain;
  }
  /* 読み込み中も visibility で隠すだけにしてレイアウトさせる（display: none だと画像が遅延読み込みされない） */
  :global([data-loading-hidden]) {
    visibility: hidden;
    opacity: 0;
  }
  :global(.is-revealing) {
    transition: opacity var(--duration-slow) var(--easing-standard);
  }
</style>

<script>
  import { GALLERY_READY_EVENT } from "../../lib/gallery-grid";

  const screen = document.getElementById("loading-screen")!;
  const content = document.getElementById(screen.dataset.loadingTarget ?? "");

  // 原本GIFの全フレーム遅延から算出した1ループ分。画像準備が先に終わってもここまでは閉じない。
  const MIN_LOADING_TIME = Number(screen.dataset.animationDuration) || 4470;
  const MAX_LOADING_TIME = Math.max(6000, MIN_LOADING_TIME); // 1周保証を優先しつつ、準備待ちは従来どおり最大6秒
  const startedAt = Date.now();
  let closed = false;
  let frozen = false;

  function freezeAnimation() {
    if (frozen) return;
    frozen = true;
    const animation = screen.querySelector<HTMLImageElement>(".loading__animation");
    const finalFrame = screen.dataset.finalFrame;
    if (animation && finalFrame) animation.src = finalFrame;
  }

  // 2周目に入らないよう、1周分が終わった時点で最終フレームに差し替える。
  setTimeout(freezeAnimation, MIN_LOADING_TIME);

  /** CSS の transition（トークンの時間）が終わったら呼ぶ。動きを減らす設定で時間が 0 なら即座に呼ぶ */
  const afterTransition = (el: HTMLElement, done: () => void) => {
    if (parseFloat(getComputedStyle(el).transitionDuration) === 0) return done();
    el.addEventListener("transitionend", done, { once: true });
  };

  function close() {
    if (closed) return;
    closed = true;
    screen.classList.add("is-leaving");
    afterTransition(screen, () => {
      screen.hidden = true;
      if (!content) return;
      content.classList.add("is-revealing");
      content.removeAttribute("data-loading-hidden");
    });
  }

  function onGalleryReady() {
    // サインアニメーションが最低1周するまでは閉じない
    setTimeout(close, Math.max(0, MIN_LOADING_TIME - (Date.now() - startedAt)));
  }

  if (document.getElementById("gallery")?.dataset.ready) onGalleryReady();
  else document.addEventListener(GALLERY_READY_EVENT, onGalleryReady, { once: true });
  setTimeout(close, MAX_LOADING_TIME);
</script>
