---
// 外部のページを iframe でその場に見せる（molecule）。
// 上端の帯に見出しと操作ボタンを置き、ページの上には重ねない（埋め込み先のナビゲーションを隠さない）。
// 操作を始めるまではページに入力を渡さない（周りのスクロールを奪わない）。
// 「終える」ボタン・外側のクリック・Escape で操作を終える
// （埋め込み先にフォーカスがあると Escape はそちらに届くため、ボタンでも終えられるようにする）。
// 作品本体または全画面ボタンを押すと root から "embed-expand"（detail: { url, title }）を送る。
// インライン操作は帯の「操作する」ボタンから明示的に開始する。何を全画面で見せるかは呼び出し側が決める。
// 読み込みの重さを隠すため、ページは画面に近づいてから読み込み（操作を始めたときも読み込む）、
// 届くまでは画面写真（poster）か、無ければタイトルを見せる。読み込みが済んだらページをフェードインする。
import Button from "../atoms/Button.astro";
import IconButton from "../atoms/IconButton.astro";
import CoverButton from "../atoms/CoverButton.astro";
import LinkButton from "../atoms/LinkButton.astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  url: string;
  title: string;
  activateLabel: string;
  deactivateLabel: string;
  openLabel: string;
  expandLabel: string;
  /** 読み込み中に見せる画面写真（<img> の属性） */
  poster?: HTMLAttributes<"img">;
}

const { url, title, activateLabel, deactivateLabel, openLabel, expandLabel, poster, ...rest } = Astro.props;
---

<div class="embed" data-embed data-url={url} data-title={title} {...rest}>
  <div class="embed__toolbar">
    <span class="embed__title">{title}</span>
    <Button size="sm" shape="pill" data-embed-activate>{activateLabel}</Button>
    <Button size="sm" shape="pill" data-embed-deactivate hidden>{deactivateLabel}</Button>
    <LinkButton href={url} external externalMark={false} size="sm" shape="pill" data-embed-open>{openLabel}</LinkButton>
    <IconButton icon="expand" size="sm" label={expandLabel} data-embed-expand />
  </div>
  <div class="embed__viewport">
    {poster ? <img class="embed__poster" {...poster} data-embed-poster /> : <span class="embed__placeholder">{title}</span>}
    <iframe
      class="embed__frame"
      data-src={url}
      title={title}
      tabindex="-1"
      sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
    ></iframe>
    <CoverButton label={`${title}: ${expandLabel}`} data-embed-expand />
  </div>
</div>

<style>
  .embed {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }
  .embed.is-active {
    outline: var(--focus-ring-width) solid var(--color-primary);
    outline-offset: calc(var(--focus-ring-width) * -1);
  }
  .embed__toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-shrink: 0;
    padding: var(--space-6) var(--space-8);
    background-color: var(--color-surface);
    color: var(--color-text);
  }
  .embed__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-bold);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .embed__viewport {
    position: relative;
    flex: 1;
    min-height: 0;
  }
  /* 画面写真はページの上端（ナビゲーション側）を合わせて敷く */
  .embed__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .embed__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-16);
    color: var(--color-text-muted);
    font-size: var(--font-size-heading);
    font-weight: var(--font-weight-bold);
    text-align: center;
  }
  .embed__frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    background-color: var(--color-surface);
    opacity: 0;
    transition: opacity var(--duration-slow) var(--easing-standard);
    pointer-events: none;
  }
  .embed__frame.is-loaded {
    opacity: 1;
  }
  .embed.is-active .embed__frame {
    pointer-events: auto;
  }
  .embed.is-active :global([data-embed-activate]) {
    display: none;
  }
</style>

<script>
  const embeds = [...document.querySelectorAll<HTMLElement>("[data-embed]")];

  /** 画面に近づいた枠からページを読み込む（先読みの距離は画面の高さの半分） */
  const PRELOAD_MARGIN = "50% 0px";

  const load = (embed: HTMLElement) => {
    const frame = embed.querySelector<HTMLIFrameElement>("iframe")!;
    if (frame.src || !frame.dataset.src) return;
    frame.addEventListener("load", () => frame.classList.add("is-loaded"), { once: true });
    frame.src = frame.dataset.src;
  };

  const observer = new IntersectionObserver(
    (records) => {
      for (const record of records) {
        if (!record.isIntersecting) continue;
        load(record.target as HTMLElement);
        observer.unobserve(record.target);
      }
    },
    { rootMargin: PRELOAD_MARGIN },
  );
  for (const embed of embeds) observer.observe(embed);

  const setActive = (active: HTMLElement | null) => {
    for (const embed of embeds) {
      const on = embed === active;
      embed.classList.toggle("is-active", on);
      embed.querySelector<HTMLElement>("[data-embed-deactivate]")!.hidden = !on;
      const frame = embed.querySelector("iframe")!;
      if (on) {
        load(embed);
        frame.removeAttribute("tabindex");
        frame.focus();
      } else {
        frame.setAttribute("tabindex", "-1");
      }
    }
  };

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const embed = target.closest<HTMLElement>("[data-embed]");
    if (!embed) return setActive(null);
    if (target.closest("[data-embed-expand]")) {
      setActive(null);
      embed.dispatchEvent(
        new CustomEvent("embed-expand", {
          detail: { url: embed.dataset.url, title: embed.dataset.title },
          bubbles: true,
        }),
      );
    } else if (target.closest("[data-embed-activate]")) setActive(embed);
    else if (target.closest("[data-embed-deactivate]")) setActive(null);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setActive(null);
  });
</script>
