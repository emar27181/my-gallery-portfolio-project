---
// 画像を画面いっぱいに見せる（molecule）。document に "lightbox-open"
// （detail: { id, items: { src, alt, caption? }[], index }）を送ると開く。背景のクリック・閉じるボタン・Escape で閉じる。
// 左右のスワイプ・説明の左右の矢印ボタン・←→キーで前後の画像に移る（items の順。端では止まる）。
// caption（説明・リンク・作成日・タグ）は画像の下に出す（work-caption.ts）。
import IconButton from "../atoms/IconButton.astro";
import "./work-caption.css";

interface Props {
  id: string;
  closeLabel: string;
  prevLabel: string;
  nextLabel: string;
}

const { id, closeLabel, prevLabel, nextLabel } = Astro.props;
---

<div class="lightbox" id={id} data-lightbox role="dialog" aria-modal="true">
  <figure class="lightbox__figure">
    <img class="lightbox__img" data-lightbox-img src="" alt="" />
    <!-- 画像の下の 1 行に「前の矢印・説明・次の矢印」を並べる（矢印を画像に重ねない） -->
    <div class="lightbox__footer">
      <div class="lightbox__nav">
        <IconButton icon="chevronLeft" variant="media" label={prevLabel} data-lightbox-prev />
      </div>
      <div class="lightbox__caption work-caption" data-lightbox-caption hidden></div>
      <div class="lightbox__nav">
        <IconButton icon="chevronRight" variant="media" label={nextLabel} data-lightbox-next />
      </div>
    </div>
  </figure>
  <div class="lightbox__close">
    <IconButton icon="close" label={closeLabel} data-lightbox-close />
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16);
    background-color: var(--color-scrim-strong);
    /* 横スワイプはこちらで扱い、縦方向の操作（拡大・スクロール）はブラウザに任せる */
    touch-action: pan-y pinch-zoom;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-base) var(--easing-standard),
      visibility var(--duration-base) var(--easing-standard);
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  /* 画像と説明を縦に並べ、説明のぶん画像を縮めて画面に収める */
  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    max-width: 100%;
    max-height: 100%;
    margin: 0;
  }
  .lightbox__footer {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-shrink: 0;
    width: 100%;
    max-width: var(--layout-content-max-width);
  }
  .lightbox__caption {
    flex: 1;
    min-width: 0;
    color: var(--color-on-scrim);
  }
  /* 切り替えた直後は前の画像を残さず消し、次の画像が描ける状態になったらフェードインする */
  .lightbox__img.is-loading {
    opacity: 0;
    transition: none;
  }
  .lightbox__img {
    transition: opacity var(--duration-fast) var(--easing-standard);
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
  }
  /* 前後の矢印は説明の左右（説明が無くても両端）。端では押せない（場所は空けたまま、行の幅を変えない） */
  .lightbox__nav {
    flex-shrink: 0;
  }
  .lightbox__footer > .lightbox__nav:last-child {
    margin-left: auto;
  }
  .lightbox__nav :global(button:disabled) {
    visibility: hidden;
  }
  /* 押せる範囲は --control-height-md のまま、見える丸だけ --space-4 ずつ内側に縮めて薄くする */
  .lightbox__nav :global(button) {
    position: relative;
    isolation: isolate;
    background-color: transparent;
    box-shadow: none;
  }
  .lightbox__nav :global(button)::before {
    content: "";
    position: absolute;
    inset: var(--space-4);
    z-index: -1;
    border-radius: var(--radius-pill);
    background-color: var(--color-media-control-subtle);
    box-shadow: var(--shadow-sm);
  }
  /* どの画面幅でも右上に固定する（スマホでも押しやすい位置） */
  .lightbox__close {
    position: fixed;
    top: var(--space-16);
    right: var(--space-16);
  }
</style>

<script>
  import { renderWorkCaption, type WorkCaption } from "./work-caption";

  interface LightboxItem {
    src: string;
    alt: string;
    caption?: WorkCaption;
  }
  interface LightboxOpenDetail {
    id: string;
    items: LightboxItem[];
    index: number;
  }

  /** これ以上横に動かしたらスワイプとみなす（px。誤操作で切り替わらない程度） */
  const SWIPE_DISTANCE = 50;

  for (const lightbox of document.querySelectorAll<HTMLElement>("[data-lightbox]")) {
    const img = lightbox.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const captionEl = lightbox.querySelector<HTMLElement>("[data-lightbox-caption]")!;
    const prev = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-prev]")!;
    const next = lightbox.querySelector<HTMLButtonElement>("[data-lightbox-next]")!;
    let items: LightboxItem[] = [];
    let index = 0;

    const isOpen = () => lightbox.classList.contains("is-open");
    const setOpen = (open: boolean) => {
      lightbox.classList.toggle("is-open", open);
      document.body.style.overflow = open ? "hidden" : "";
    };

    const show = (i: number) => {
      if (items.length === 0) return;
      index = Math.min(Math.max(i, 0), items.length - 1);
      const item = items[index];
      if (img.getAttribute("src") !== item.src) {
        img.classList.add("is-loading");
        img.src = item.src;
        // 速く切り替えたとき、前に頼んだ画像の完了で今の画像を見せてしまわないよう、src が同じか確かめる
        const requested = item.src;
        img
          .decode()
          .catch(() => undefined)
          .then(() => {
            if (img.getAttribute("src") === requested) img.classList.remove("is-loading");
          });
      }
      img.alt = item.alt;
      // 前後の画像を先に読み込んでおき、切り替えをすぐ終わらせる
      for (const neighbor of [items[index - 1], items[index + 1]]) {
        if (neighbor) new Image().src = neighbor.src;
      }
      renderWorkCaption(captionEl, item.caption);
      prev.disabled = index === 0;
      next.disabled = index === items.length - 1;
    };

    document.addEventListener("lightbox-open", (e) => {
      const detail = (e as CustomEvent<LightboxOpenDetail>).detail;
      if (detail.id !== lightbox.id || detail.items.length === 0) return;
      items = detail.items;
      show(detail.index);
      setOpen(true);
    });

    lightbox.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("[data-lightbox-prev]")) return show(index - 1);
      if (target.closest("[data-lightbox-next]")) return show(index + 1);
      const background = target === lightbox || target.classList.contains("lightbox__figure");
      if (background || target.closest("[data-lightbox-close]")) setOpen(false);
    });

    // 横方向のスワイプで前後に移る（縦方向が大きい動きは無視する）
    let start: { x: number; y: number } | null = null;
    lightbox.addEventListener(
      "touchstart",
      (e) => {
        start = e.touches.length === 1 ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : null;
      },
      { passive: true },
    );
    lightbox.addEventListener("touchend", (e) => {
      if (!start) return;
      const touch = e.changedTouches[0];
      const dx = touch.clientX - start.x;
      const dy = touch.clientY - start.y;
      start = null;
      if (Math.abs(dx) < SWIPE_DISTANCE || Math.abs(dx) < Math.abs(dy)) return;
      show(dx < 0 ? index + 1 : index - 1);
    });

    document.addEventListener("keydown", (e) => {
      if (!isOpen()) return;
      if (e.key === "Escape") setOpen(false);
      else if (e.key === "ArrowLeft") show(index - 1);
      else if (e.key === "ArrowRight") show(index + 1);
    });
  }
</script>
