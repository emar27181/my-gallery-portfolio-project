---
// 画像を画面いっぱいに見せる（molecule）。document に "lightbox-open"
// （detail: { id, src, alt, caption? }）を送ると開く。背景のクリック・閉じるボタン・Escape で閉じる。
// caption（説明・リンク・作成日・タグ）は画像の下に出す（work-caption.ts）。
import IconButton from "../atoms/IconButton.astro";
import "./work-caption.css";

interface Props {
  id: string;
  closeLabel: string;
}

const { id, closeLabel } = Astro.props;
---

<div class="lightbox" id={id} data-lightbox role="dialog" aria-modal="true">
  <figure class="lightbox__figure">
    <img class="lightbox__img" data-lightbox-img src="" alt="" />
    <figcaption class="lightbox__caption work-caption" data-lightbox-caption hidden></figcaption>
  </figure>
  <div class="lightbox__close">
    <IconButton icon="close" label={closeLabel} data-lightbox-close />
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16);
    background-color: var(--color-scrim-strong);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-base) var(--easing-standard),
      visibility var(--duration-base) var(--easing-standard);
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  /* 画像と説明を縦に並べ、説明のぶん画像を縮めて画面に収める */
  .lightbox__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    max-width: 100%;
    max-height: 100%;
    margin: 0;
  }
  .lightbox__caption {
    flex-shrink: 0;
    width: 100%;
    max-width: var(--layout-content-max-width);
    color: var(--color-on-scrim);
  }
  .lightbox__img {
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
  }
  /* どの画面幅でも右上に固定する（スマホでも押しやすい位置） */
  .lightbox__close {
    position: fixed;
    top: var(--space-16);
    right: var(--space-16);
  }
</style>

<script>
  import { renderWorkCaption, type WorkCaption } from "./work-caption";

  interface LightboxOpenDetail {
    id: string;
    src: string;
    alt: string;
    caption?: WorkCaption;
  }

  const setOpen = (lightbox: HTMLElement, open: boolean) => {
    lightbox.classList.toggle("is-open", open);
    document.body.style.overflow = open ? "hidden" : "";
  };

  document.addEventListener("lightbox-open", (e) => {
    const { id, src, alt, caption } = (e as CustomEvent<LightboxOpenDetail>).detail;
    const lightbox = document.getElementById(id);
    const img = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const captionEl = lightbox?.querySelector<HTMLElement>("[data-lightbox-caption]");
    if (!lightbox || !img || !captionEl) return;
    img.src = src;
    img.alt = alt;
    renderWorkCaption(captionEl, caption);
    setOpen(lightbox, true);
  });

  for (const lightbox of document.querySelectorAll<HTMLElement>("[data-lightbox]")) {
    lightbox.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const background = target === lightbox || target.classList.contains("lightbox__figure");
      if (background || target.closest("[data-lightbox-close]")) setOpen(lightbox, false);
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    for (const lightbox of document.querySelectorAll<HTMLElement>("[data-lightbox].is-open")) setOpen(lightbox, false);
  });
</script>
