---
// サムネイルを押すとその場で再生する動画（molecule）。
// サムネイルの属性・埋め込み URL・文言は props で受け取る。
import type { HTMLAttributes } from "astro/types";
import CoverButton from "../atoms/CoverButton.astro";
import Icon from "../atoms/Icon.astro";

interface Props {
  embedUrl: string;
  title: string;
  playLabel: string;
  thumbnail: HTMLAttributes<"img">;
}

const { embedUrl, title, playLabel, thumbnail } = Astro.props;
---

<div class="video" data-video data-embed-src={embedUrl}>
  <img class="video__thumbnail" data-video-thumbnail {...thumbnail} />
  <iframe
    class="video__player"
    title={title}
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    hidden></iframe>
  <CoverButton label={`${title}: ${playLabel}`} data-video-play>
    <Icon name="play" size="md" />
  </CoverButton>
</div>

<style>
  .video {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .video__thumbnail,
  .video__player {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    object-fit: cover;
  }
  /* 再生UIは動画だけ簡素化。無彩色・小さめ・影なし・枠なし。 */
  .video :global([data-video-play] .cover__hint) {
    width: var(--control-height-md);
    min-height: var(--control-height-md);
    padding: 0;
    border-color: transparent;
    background-color: var(--color-media-control);
    color: var(--color-on-media-control);
    box-shadow: none;
  }
  .video :global([data-video-play]:hover) {
    background-color: transparent;
  }
</style>

<script>
  document.addEventListener("click", (e) => {
    const play = (e.target as HTMLElement).closest<HTMLElement>("[data-video-play]");
    const video = play?.closest<HTMLElement>("[data-video]");
    if (!play || !video) return;
    const player = video.querySelector("iframe")!;
    player.src = video.dataset.embedSrc ?? "";
    player.hidden = false;
    video.querySelector<HTMLElement>("[data-video-thumbnail]")!.hidden = true;
    play.hidden = true;
  });
</script>
