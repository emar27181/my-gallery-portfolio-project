---
// 動画サムネイル（molecule）。作品本体を押すと共通の拡大ビューを開く。
// 実際のプレイヤー表示・前後移動は organism 側が管理する。
import type { HTMLAttributes } from "astro/types";
import CoverButton from "../atoms/CoverButton.astro";
import Icon from "../atoms/Icon.astro";

interface Props {
  embedUrl: string;
  externalUrl: string;
  title: string;
  playLabel: string;
  thumbnail: HTMLAttributes<"img">;
}

const { embedUrl, externalUrl, title, playLabel, thumbnail } = Astro.props;
---

<div class="video" data-video data-url={embedUrl} data-external-url={externalUrl} data-title={title}>
  <img class="video__thumbnail" data-video-thumbnail {...thumbnail} />
  <CoverButton label={`${title}: ${playLabel}`} data-video-expand>
    <Icon name="play" size="md" />
  </CoverButton>
</div>

<style>
  .video {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .video__thumbnail {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video :global([data-video-expand] .cover__hint) {
    width: var(--control-height-md);
    min-height: var(--control-height-md);
    padding: 0;
    border-color: transparent;
    background-color: var(--color-media-control);
    color: var(--color-on-media-control);
    box-shadow: none;
  }
  .video :global([data-video-expand]:hover) {
    background-color: transparent;
  }
</style>

<script>
  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-video-expand]");
    const video = trigger?.closest<HTMLElement>("[data-video]");
    if (!trigger || !video) return;
    video.dispatchEvent(
      new CustomEvent("embed-expand", {
        detail: {
          url: video.dataset.url ?? "",
          title: video.dataset.title ?? "",
          externalUrl: video.dataset.externalUrl ?? "",
        },
        bubbles: true,
      }),
    );
  });
</script>
