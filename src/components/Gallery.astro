---
import { DEFAULT_SORT, SORT_OPTIONS, tagsByUsage } from "../lib/gallery";
import { GALLERY_BREAKPOINTS, galleryGridCss, gallerySizes } from "../lib/gallery-grid";
import { getGalleryEntries } from "../lib/gallery-images";

const entries = await getGalleryEntries();
const allTags = tagsByUsage(entries);
// HTML を読んだ時点で取りに行く枚数（最大列数 = 最初の1行ぶん）。残りはスクリプトが画面に入る分を判断する
const EAGER_COUNT = Math.max(...GALLERY_BREAKPOINTS.map((bp) => bp.columns));
---

<style is:global set:html={galleryGridCss(".gallery-grid")}></style>

<div class="gallery-container">
  <!-- 🏷️ フィルター & ソート -->
  <div class="controls-container">
    <div class="filter-container">
      <span class="filter-label">フィルタ:</span>
      <div class="filter-tags-container">
        <div class="filter-tags" id="filter-tags">
          <span class="filter-placeholder">タグを選択</span>
        </div>
        <div class="filter-dropdown" id="filter-dropdown">
          <div class="filter-option selected" data-value="">全て</div>
          {
            allTags.map((tag) => (
              <div class="filter-option" data-value={tag}>
                {tag}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="sort-container">
      <label for="sort-select" class="sort-label">並び替え:</label>
      <select id="sort-select" class="sort-select">
        {
          SORT_OPTIONS.map(({ value, label }) => (
            <option value={value} selected={value === DEFAULT_SORT}>
              {label}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <!-- 🖼 ギャラリー -->
  <div id="gallery" class="gallery-grid">
    {
      entries.map(({ index, title, alt, date, tags, type, videoId, width, height, span, thumb, full, color }) => {
        const img = {
          src: thumb.src,
          srcset: thumb.srcset,
          sizes: gallerySizes(span),
          width,
          height,
          alt,
          title,
          loading: index < EAGER_COUNT ? ("eager" as const) : ("lazy" as const),
          decoding: "async" as const,
          "data-full": full,
        };
        return (
          <div
            class="gallery-item"
            data-index={index}
            data-title={title}
            data-date={date}
            data-tags={tags.join(",")}
            data-type={type}
            data-video-id={videoId}
            data-aspect={height / width}
            data-span={span}
            style={{ "--item-aspect": `${width} / ${height}`, "--item-span": span, "--item-color": color }}
          >
            <div class="gallery-item-container">
              {type === "video" ? (
                <div class="video-content">
                  <img class="video-thumbnail" {...img} />
                  <div class="video-player-container" hidden>
                    <iframe
                      class="video-player"
                      title={title}
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    />
                  </div>
                  <div class="video-overlay">
                    <div class="play-button">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </div>
                  </div>
                </div>
              ) : (
                <img {...img} />
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<!-- Image Modal -->
<div class="image-modal" id="image-modal">
  <div class="image-modal-overlay" id="image-modal-overlay">
    <div class="image-modal-content">
      <img class="image-modal-img" id="image-modal-img" src="" alt="" />
      <button class="image-modal-close" id="image-modal-close" aria-label="Close image">
        <svg fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  import {
    DEFAULT_SORT,
    isSortKey,
    matchesAllTags,
    sortItems,
    type SortKey,
    type SortableItem,
  } from "../lib/gallery";
  import { GALLERY_READY_EVENT } from "../lib/gallery-grid";
  import { layoutMasonry, type Placement } from "../lib/masonry";

  interface Entry extends SortableItem {
    el: HTMLElement;
    img: HTMLImageElement;
    /** 高さ / 幅 */
    aspect: number;
    span: number;
  }

  const grid = document.getElementById("gallery")!;
  const filterTags = document.getElementById("filter-tags")!;
  const filterDropdown = document.getElementById("filter-dropdown")!;
  const filterPlaceholder = filterTags.querySelector<HTMLElement>(".filter-placeholder")!;
  const filterOptions = [...filterDropdown.querySelectorAll<HTMLElement>(".filter-option")];
  const sortSelect = document.getElementById("sort-select") as HTMLSelectElement;
  const imageModal = document.getElementById("image-modal")!;
  const imageModalImg = document.getElementById("image-modal-img") as HTMLImageElement;

  const entries: Entry[] = [...grid.querySelectorAll<HTMLElement>(".gallery-item")].map((el) => ({
    el,
    img: el.querySelector("img")!,
    index: Number(el.dataset.index),
    title: el.dataset.title ?? "",
    date: el.dataset.date ?? "",
    tags: (el.dataset.tags ?? "").split(",").filter(Boolean),
    aspect: Number(el.dataset.aspect),
    span: Number(el.dataset.span),
  }));

  // 表示状態はここだけに持ち、変更後は必ず render() で DOM に反映する
  const state: { selectedTags: string[]; sort: SortKey } = {
    selectedTags: [],
    sort: DEFAULT_SORT,
  };

  // --- 配置 -----------------------------------------------------------------------
  // 列数と間隔は CSS 変数（src/lib/gallery-grid.ts から生成）が定義元
  const gridVar = (name: string) => parseFloat(getComputedStyle(grid).getPropertyValue(name));

  /** 表示するアイテムを並び順どおりに最短列へ詰め、各アイテムの位置を返す */
  function layout(): { shown: Entry[]; placements: Placement[] } {
    const shown = sortItems(entries, state.sort).filter((e) => matchesAllTags(e.tags, state.selectedTags));
    const shownSet = new Set(shown);
    const { placements, height } = layoutMasonry(shown, {
      containerWidth: grid.clientWidth,
      columns: gridVar("--gallery-columns"),
      gap: gridVar("--gallery-gap"),
    });

    for (const entry of entries) entry.el.hidden = !shownSet.has(entry);
    shown.forEach(({ el }, i) => {
      const { x, y, width, height } = placements[i];
      el.style.transform = `translate(${x}px, ${y}px)`;
      el.style.width = `${width}px`;
      el.style.height = `${height}px`;
    });
    grid.style.height = `${height}px`;
    grid.classList.add("is-masonry");
    return { shown, placements };
  }

  function render() {
    layout();
    renderFilter();
  }

  function renderFilter() {
    for (const option of filterOptions) {
      const value = option.dataset.value ?? "";
      option.classList.toggle(
        "selected",
        value === "" ? state.selectedTags.length === 0 : state.selectedTags.includes(value),
      );
    }

    filterTags.querySelectorAll(".selected-tag").forEach((chip) => chip.remove());
    filterPlaceholder.style.display = state.selectedTags.length === 0 ? "block" : "none";

    for (const tag of state.selectedTags) {
      const chip = document.createElement("span");
      chip.className = "selected-tag";
      const remove = document.createElement("button");
      remove.className = "remove-tag";
      remove.type = "button";
      remove.dataset.tag = tag;
      remove.setAttribute("aria-label", `${tag} を解除`);
      remove.textContent = "×";
      chip.append(`${tag} `, remove);
      filterTags.append(chip);
    }
  }

  function toggleTag(tag: string) {
    state.selectedTags = state.selectedTags.includes(tag)
      ? state.selectedTags.filter((t) => t !== tag)
      : [...state.selectedTags, tag];
    render();
  }

  // --- 画像の読み込み -------------------------------------------------------------
  // 読み込み済みの画像だけを表示し（それまでは代表色）、届いたものからフェードインする
  const markLoaded = (img: HTMLImageElement) => img.classList.add("is-loaded");
  grid.addEventListener(
    "load",
    (e) => {
      if (e.target instanceof HTMLImageElement) markLoaded(e.target);
    },
    true,
  );
  for (const { img } of entries) if (img.complete && img.naturalWidth > 0) markLoaded(img);

  /**
   * 初期表示に入る画像を最優先で読み込み、デコードまで済ませる。
   * ローディング画面はこれを待って閉じるので、幕が上がった時点で画面内は描画済みになる
   */
  async function prepareFirstView({ shown, placements }: ReturnType<typeof layout>) {
    const visibleBottom = window.innerHeight - grid.getBoundingClientRect().top;
    const critical = shown.filter((_, i) => placements[i].y < visibleBottom).map((e) => e.img);
    for (const img of critical) {
      img.loading = "eager";
      img.fetchPriority = "high";
    }
    await Promise.all(
      critical.map((img) =>
        img.decode().then(
          () => markLoaded(img),
          () => undefined, // 失敗しても待ち続けない（代表色のまま表示する）
        ),
      ),
    );
    grid.dataset.ready = "true";
    document.dispatchEvent(new Event(GALLERY_READY_EVENT));
  }

  // --- 画像モーダル -------------------------------------------------------------
  function openImageModal(img: HTMLImageElement) {
    imageModalImg.src = img.dataset.full || img.currentSrc || img.src;
    imageModalImg.alt = img.alt || img.title;
    imageModal.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeImageModal() {
    imageModal.classList.remove("open");
    document.body.style.overflow = "";
  }

  // --- 動画: その場で再生／サムネイルに戻す ---------------------------------------
  function toggleInlineVideo(item: HTMLElement) {
    const thumbnail = item.querySelector<HTMLElement>(".video-thumbnail")!;
    const player = item.querySelector<HTMLElement>(".video-player-container")!;
    const overlay = item.querySelector<HTMLElement>(".video-overlay")!;
    const iframe = player.querySelector("iframe")!;
    const playing = !player.hidden;

    thumbnail.hidden = !playing;
    overlay.hidden = !playing;
    player.hidden = playing;
    iframe.src = playing
      ? ""
      : `https://www.youtube.com/embed/${item.dataset.videoId}?autoplay=1&mute=0&loop=0&vq=hd1080`;
  }

  // --- イベント -----------------------------------------------------------------
  filterTags.addEventListener("click", (e) => {
    const remove = (e.target as HTMLElement).closest<HTMLElement>(".remove-tag");
    if (remove) {
      toggleTag(remove.dataset.tag ?? "");
      return;
    }
    filterDropdown.classList.toggle("open");
  });

  filterDropdown.addEventListener("click", (e) => {
    const option = (e.target as HTMLElement).closest<HTMLElement>(".filter-option");
    if (!option) return;
    // 複数選択できるようドロップダウンは開いたままにする
    const value = option.dataset.value ?? "";
    if (value === "") {
      state.selectedTags = [];
      render();
    } else {
      toggleTag(value);
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!filterTags.contains(target) && !filterDropdown.contains(target)) {
      filterDropdown.classList.remove("open");
    }
  });

  sortSelect.addEventListener("change", () => {
    if (isSortKey(sortSelect.value)) {
      state.sort = sortSelect.value;
      render();
    }
  });

  grid.addEventListener("click", (e) => {
    const item = (e.target as HTMLElement).closest<HTMLElement>(".gallery-item");
    if (!item) return;
    if (item.dataset.type === "video" && item.dataset.videoId) {
      toggleInlineVideo(item);
    } else {
      const img = item.querySelector("img");
      if (img) openImageModal(img);
    }
  });

  document.getElementById("image-modal-close")!.addEventListener("click", closeImageModal);
  imageModal.addEventListener("click", (e) => {
    if (e.target === imageModal || e.target === document.getElementById("image-modal-overlay")) {
      closeImageModal();
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && imageModal.classList.contains("open")) closeImageModal();
  });

  // 幅が変わったら詰め直す（高さの変化は自分で設定したものなので無視する）
  let lastWidth = grid.clientWidth;
  new ResizeObserver(() => {
    if (grid.clientWidth === lastWidth) return;
    lastWidth = grid.clientWidth;
    layout();
  }).observe(grid);

  renderFilter();
  prepareFirstView(layout());
  // 初回配置の後からアニメーションを有効にする
  requestAnimationFrame(() => requestAnimationFrame(() => grid.classList.add("is-animated")));
</script>
