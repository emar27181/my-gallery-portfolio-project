---
// アイコン（atom）。形は Lucide ベースの icons.ts、大きさはトークンの段階から選ぶ。
// Lucide と同じく fill なし・stroke=currentColor で描画する。
import type { HTMLAttributes } from "astro/types";
import { ICONS, type IconName } from "./icons";

interface Props extends HTMLAttributes<"svg"> {
  name: IconName;
  size?: "sm" | "md" | "lg";
}

const { name, size = "md", class: className, ...rest } = Astro.props;
const paths = ICONS[name];
---

<svg
  class:list={["icon", `icon--${size}`, className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  {paths.map((path) => <path d={path}></path>)}
</svg>

<style>
  .icon {
    display: block;
    flex-shrink: 0;
  }
  .icon--sm {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }
  .icon--md {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }
  .icon--lg {
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
  }
</style>
