---
// アイコン（atom）。形は icons.ts、大きさはトークンの段階から選ぶ。色は親の文字色を継ぐ。
import type { HTMLAttributes } from "astro/types";
import { ICONS, type IconName } from "./icons";

interface Props extends HTMLAttributes<"svg"> {
  name: IconName;
  size?: "sm" | "md" | "lg";
}

const { name, size = "md", class: className, ...rest } = Astro.props;
const { viewBox, path } = ICONS[name];
---

<svg
  class:list={["icon", `icon--${size}`, className]}
  viewBox={viewBox}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  <path fill-rule="evenodd" clip-rule="evenodd" d={path}></path>
</svg>

<style>
  .icon {
    display: block;
    flex-shrink: 0;
  }
  .icon--sm {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }
  .icon--md {
    width: var(--icon-size-md);
    height: var(--icon-size-md);
  }
  .icon--lg {
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
  }
</style>
