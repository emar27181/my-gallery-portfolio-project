---
// チップ（atom）。色・文言・選択状態だけを受け取る。何を表すかは呼び出し側が決める。
import type { HTMLAttributes } from "astro/types";
import "../../styles/tag-pill.css";

type Props = HTMLAttributes<"span"> & {
  /** 塗り（primary）で示す */
  selected?: boolean;
};

const { selected = false, class: className, ...rest } = Astro.props;
---

<span class:list={["chip", "tag-pill", { "tag-pill--filled": selected }, className]} {...rest}>
  <slot />
</span>

<style>
  .chip {
    gap: var(--space-4);
  }
</style>
