---
// チップ（atom）。色・文言・選択状態だけを受け取る。何を表すかは呼び出し側が決める。
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span"> & {
  /** 塗り（primary）で示す */
  selected?: boolean;
};

const { selected = false, class: className, ...rest } = Astro.props;
---

<span class:list={["chip", { "chip--selected": selected }, className]} {...rest}>
  <slot />
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--control-height-sm);
    padding: 0 var(--space-4) 0 var(--space-10);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-muted);
    color: var(--color-text);
    font-size: var(--font-size-caption);
    line-height: var(--line-height-tight);
    white-space: nowrap;
  }
  .chip--selected {
    background-color: color-mix(in srgb, var(--tag-color, var(--color-primary)) 16%, var(--color-surface));
    color: var(--tag-color, var(--color-primary));
  }
  :global([data-tone="neutral"]) { --tag-color: var(--color-tag-neutral); }
  :global([data-tone="red"]) { --tag-color: var(--color-tag-red); }
  :global([data-tone="blue"]) { --tag-color: var(--color-tag-blue); }
  :global([data-tone="violet"]) { --tag-color: var(--color-tag-violet); }
  :global([data-tone="emerald"]) { --tag-color: var(--color-tag-emerald); }
  :global([data-tone="orange"]) { --tag-color: var(--color-tag-orange); }
  :global([data-tone="pink"]) { --tag-color: var(--color-tag-pink); }
  :global([data-tone="cyan"]) { --tag-color: var(--color-tag-cyan); }
  :global([data-tone="amber"]) { --tag-color: var(--color-tag-amber); }
  :global([data-tone="indigo"]) { --tag-color: var(--color-tag-indigo); }
</style>
